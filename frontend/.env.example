# ─── Dark Shield Frontend — Environment Variables ────────────────────────────
# Copy to .env and fill in your values.  Never commit .env to Git.

# Backend API URL
VITE_API_URL=http://localhost:8000

# Clerk publishable key (get from dashboard.clerk.com)
# Leave empty to run without Clerk authentication (demo mode)
VITE_CLERK_PUBLISHABLE_KEY=
